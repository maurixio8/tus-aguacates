# n8n API Configuration
# Copia este archivo a .env.n8n y completa los valores

# URL base de tu instancia de n8n (sin trailing slash)
N8N_BASE_URL=https://dep-n8n.n8ntusaguacates.space

# API Key de n8n (obtenida desde Settings > API en n8n)
# Se envía como header X-N8N-API-KEY
N8N_API_KEY=tu_api_key_aqui
