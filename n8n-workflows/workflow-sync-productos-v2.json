{
    "name": "🔄 Sync Productos Supabase → Local v2",
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "hours",
                            "hoursInterval": 1
                        }
                    ]
                }
            },
            "id": "schedule-trigger",
            "name": "⏰ Cada Hora",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1,
            "position": [
                180,
                300
            ]
        },
        {
            "parameters": {
                "resource": "row",
                "operation": "getAll",
                "tableId": "products",
                "limit": 500
            },
            "id": "fetch-supabase",
            "name": "📥 Obtener Productos Supabase",
            "type": "n8n-nodes-base.supabase",
            "typeVersion": 1,
            "position": [
                400,
                300
            ],
            "credentials": {
                "supabaseApi": {
                    "id": "REEMPLAZAR",
                    "name": "Supabase account 2"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "// Este nodo hace DOS cosas:\n// 1. Ejecuta DELETE para limpiar la tabla\n// 2. Retorna los productos transformados para insertar\n\nconst productos = [];\n\nfor (const item of $input.all()) {\n  const p = item.json;\n  \n  productos.push({\n    json: {\n      supabase_id: p.id || null,\n      name: p.name || 'Sin nombre',\n      slug: p.slug || null,\n      description: p.description || null,\n      price: parseFloat(p.price) || 0,\n      discount_price: p.discount_price ? parseFloat(p.discount_price) : null,\n      category_name: p.category?.name || p.category_name || null,\n      category_id: p.category_id || null,\n      main_image_url: p.main_image_url || p.image_url || null,\n      stock: parseInt(p.stock) || 100,\n      is_active: p.is_active !== false,\n      is_featured: p.is_featured === true,\n      synced_from_supabase_at: new Date().toISOString()\n    }\n  });\n}\n\nconsole.log(`Transformados ${productos.length} productos`);\nreturn productos;"
            },
            "id": "transform-data",
            "name": "🔄 Transformar Datos",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                620,
                300
            ]
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "DELETE FROM productos_tienda; SELECT 1 as cleaned;",
                "options": {}
            },
            "id": "clear-table",
            "name": "🗑️ Limpiar Tabla",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2,
            "position": [
                620,
                500
            ],
            "credentials": {
                "postgres": {
                    "id": "REEMPLAZAR",
                    "name": "Mi PostgreSQL Docker"
                }
            }
        },
        {
            "parameters": {
                "mode": "combine",
                "combinationMode": "multiplex",
                "options": {}
            },
            "id": "merge-node",
            "name": "🔀 Esperar Limpieza",
            "type": "n8n-nodes-base.merge",
            "typeVersion": 2.1,
            "position": [
                840,
                300
            ]
        },
        {
            "parameters": {
                "operation": "insert",
                "schema": {
                    "value": "public"
