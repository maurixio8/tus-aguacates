        {
            "parameters": {
                "jsCode": "// Recuperar productos guardados en memoria\nconst staticData = $getWorkflowStaticData('global');\nconst productos = staticData.productosParaInsertar || [];\n\nif (productos.length === 0) {\n  throw new Error('No hay productos para insertar. El flujo falló.');\n}\n\n// Limpiar memoria después de recuperar\ndelete staticData.productosParaInsertar;\n\n// Retornar los productos como items para insertar\nreturn productos.map(p => ({ json: p }));"
            },
