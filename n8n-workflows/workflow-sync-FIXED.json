        {
            "parameters": {
                "jsCode": "// Transformar Y guardar en memoria para después del DELETE\nconst staticData = $getWorkflowStaticData('global');\nconst productos = [];\n\nfor (const item of $input.all()) {\n  const p = item.json;\n  \n  productos.push({\n    supabase_id: p.id,\n    name: p.name || 'Sin nombre',\n    slug: p.slug || null,\n    description: p.description || null,\n    price: parseFloat(p.price) || 0,\n    discount_price: p.discount_price ? parseFloat(p.discount_price) : null,\n    category_name: p.category?.name || p.category_name || null,\n    category_id: p.category_id || null,\n    main_image_url: p.main_image_url || p.image_url || null,\n    stock: parseInt(p.stock) || 100,\n    is_active: p.is_active !== false,\n    is_featured: p.is_featured === true,\n    synced_from_supabase_at: new Date().toISOString()\n  });\n}\n\n// Guardar en memoria estática\nstaticData.productosParaInsertar = productos;\nstaticData.totalProductos = productos.length;\n\n// Retornar un item dummy para continuar el flujo\nreturn [{ json: { mensaje: `${productos.length} productos listos para insertar`, continuar: true } }];"
            },
            "id": "65e4218f-d8c8-495c-a836-04c554514af7",
