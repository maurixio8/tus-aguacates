        {
            "parameters": {
                "operation": "executeQuery",
                "query": "SELECT \n  id,\n  nombre,\n  telefono,\n  total_pedidos,\n  total_gastado\nFROM clientes\nWHERE \n  nombre IS NOT NULL \n  AND nombre != ''\n  AND total_pedidos >= 6\n  AND activo = true\n  AND telefono IS NOT NULL\nORDER BY total_pedidos DESC, total_gastado DESC\nLIMIT 151;",
                "options": {}
            },
            "id": "postgres-get-vip-clients",
            "name": "Obtener 151 Clientes VIP",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2.4,
            "position": [
                460,
                300
            ],
            "credentials": {
                "postgres": {
                    "id": "TU_CREDENCIAL_POSTGRES",
                    "name": "PostgreSQL - Local"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "// Preparar datos para cada cliente\nconst clientes = items.map(item => {\n  const cliente = item.json;\n  \n  return {\n    json: {\n      cliente_id: cliente.id,\n      nombre: cliente.nombre,\n      telefono: cliente.telefono,\n      total_pedidos: cliente.total_pedidos,\n      total_gastado: cliente.total_gastado,\n      // Formatear número de teléfono para WhatsApp\n      whatsapp_number: cliente.telefono.startsWith('+') ? cliente.telefono : `+57${cliente.telefono}`,\n      // Datos para el mensaje\n      mensaje_data: {\n        from: \"+573042582777\",\n        to: cliente.telefono.startsWith('+') ? cliente.telefono : `+57${cliente.telefono}`,\n        type: \"template\",\n        template: {\n          name: \"template_marketing_20251222162632\",\n          language: {\n            code: \"es\"\n          },\n          components: [\n            {\n              type: \"header\",\n              parameters: [\n                {\n                  type: \"text\",\n                  text: cliente.nombre\n                }\n              ]\n            }\n          ]\n        }\n      }\n    }\n  };\n});\n\nreturn clientes;"
            },
            "id": "code-prepare-messages",
            "name": "Preparar Mensajes",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                680,
                300
            ]
        },
