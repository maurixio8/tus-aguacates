            "id": "fetch-variantes",
            "name": "📥 Variantes Supabase",
            "type": "n8n-nodes-base.supabase",
            "typeVersion": 1,
            "position": [
                660,
                500
            ],
            "credentials": {
                "supabaseApi": {
                    "id": "oFlOZEZmGLS2kaKr",
                    "name": "Supabase account 2"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "// Insertar productos - SIN category_id que tiene tipo incompatible\nconst productos = $input.all();\nconst resultados = [];\n\nfor (const item of productos) {\n  const p = item.json;\n  if (p.is_active === false) continue;\n  \n  const escape = (val) => val ? String(val).replace(/'/g, \"''\") : null;\n  \n  const name = escape(p.name) || 'Sin nombre';\n  const slug = escape(p.slug);\n  const description = escape(p.description);\n  const price = parseFloat(p.price) || 0;\n  const discount_price = p.discount_price ? parseFloat(p.discount_price) : null;\n  const category_name = escape(p.category?.name || p.category_name);\n  const main_image_url = escape(p.main_image_url || p.image_url);\n  const stock = parseInt(p.stock) || 100;\n  const is_active = p.is_active !== false;\n  const is_featured = p.is_featured === true;\n  const supabase_id = p.id;\n  \n  resultados.push({\n    json: {\n      query: `INSERT INTO productos_tienda (supabase_id, name, slug, description, price, discount_price, category_name, main_image_url, stock, is_active, is_featured, synced_from_supabase_at) VALUES ('${supabase_id}', '${name}', ${slug ? \"'\" + slug + \"'\" : 'NULL'}, ${description ? \"'\" + description + \"'\" : 'NULL'}, ${price}, ${discount_price !== null ? discount_price : 'NULL'}, ${category_name ? \"'\" + category_name + \"'\" : 'NULL'}, ${main_image_url ? \"'\" + main_image_url + \"'\" : 'NULL'}, ${stock}, ${is_active}, ${is_featured}, NOW());`\n    }\n  });\n}\n\nreturn resultados;"
            },
            "id": "preparar-productos",
            "name": "🔄 Preparar INSERTs Productos",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                900,
                300
            ]
        },
        {
            "parameters": {
                "jsCode": "// Insertar variantes una por una via query\nconst variantes = $input.all();\nconst resultados = [];\n\nfor (const item of variantes) {\n  const v = item.json;\n  if (v.is_active === false) continue;\n  \n  const escape = (val) => val ? String(val).replace(/'/g, \"''\") : null;\n  \n  const supabase_id = v.id;\n  const product_supabase_id = v.product_id;\n  const variant_name = escape(v.variant_name) || 'Variante';\n  const variant_value = escape(v.variant_value) || '';\n  const price = parseFloat(v.price) || 0;\n  const price_adjustment = parseFloat(v.price_adjustment) || 0;\n  const stock_quantity = parseInt(v.stock_quantity) || 100;\n  const sku = escape(v.sku);\n  const is_active = v.is_active !== false;\n  const sort_order = parseInt(v.sort_order) || 0;\n  \n  resultados.push({\n    json: {\n      query: `INSERT INTO variantes_productos (supabase_id, product_supabase_id, variant_name, variant_value, price, price_adjustment, stock_quantity, sku, is_active, sort_order, synced_from_supabase_at) VALUES ('${supabase_id}', '${product_supabase_id}', '${variant_name}', '${variant_value}', ${price}, ${price_adjustment}, ${stock_quantity}, ${sku ? \"'\" + sku + \"'\" : 'NULL'}, ${is_active}, ${sort_order}, NOW());`\n    }\n  });\n}\n\n// Si no hay variantes, retornar un dummy\nif (resultados.length === 0) {\n  return [{ json: { query: 'SELECT 1 as no_variantes;' } }];\n}\n\nreturn resultados;"
            },
            "id": "preparar-variantes",
            "name": "🔄 Preparar INSERTs Variantes",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                900,
                500
            ]
        },
