                "query": "INSERT INTO envios_campana (\n  campana_id,\n  cliente_id, \n  telefono,\n  nombre_enviado,\n  estado,\n  ycloud_message_id\n)\nVALUES (\n  '{{ $('🔧 Preparar Mensajes').item.json.campana_id }}',\n  {{ $('🔧 Preparar Mensajes').item.json.cliente_id }},\n  '{{ $json.to }}',\n  '{{ $('🔧 Preparar Mensajes').item.json.nombre }}',\n  '{{ $json.status }}',\n  '{{ $json.id }}'\n)\nON CONFLICT (campana_id, telefono) DO NOTHING\nRETURNING id, telefono, estado;",
