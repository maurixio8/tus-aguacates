            "id": "700c0f2f-fee2-4136-a8ae-73c472edbd42",
            "name": "▶️ Iniciar Campaña",
            "type": "n8n-nodes-base.manualTrigger",
            "typeVersion": 1,
            "position": [
                192,
                48
            ]
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "-- ============================================\n-- ⭐ CAMPAÑA VIP - 250 MEJORES CLIENTES\n-- ============================================\nSELECT \n  c.id,\n  c.nombre,\n  c.telefono,\n  c.total_pedidos,\n  c.total_gastado,\n  COALESCE(SPLIT_PART(c.nombre, ' ', 1), 'Amigo') as primer_nombre\nFROM clientes c\nWHERE \n  c.activo = true\n  AND c.telefono IS NOT NULL\n  AND c.telefono != ''\n  AND LENGTH(c.telefono) >= 10\n  AND c.nombre IS NOT NULL\n  AND LENGTH(c.nombre) > 3\n  AND c.direccion IS NOT NULL\n  AND NOT EXISTS (\n    SELECT 1 FROM envios_campana ec \n    WHERE ec.telefono = c.telefono \n      AND ec.campana_id = 'invitatienda_enero_2026'\n  )\nORDER BY c.fecha_registro DESC\nLIMIT 250;",
                "options": {}
            },
            "id": "b9276f48-b3d3-4f96-904f-bfe41c6df1e4",
            "name": "📋 Obtener Clientes NO Enviados",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2.4,
            "position": [
                416,
                48
            ],
            "credentials": {
                "postgres": {
                    "id": "R6hc0vEZJhKQSi3G",
                    "name": "Mi PostgreSQL Docker"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "// ============================================\n// ⭐ CONFIGURACIÓN DE CAMPAÑA\n// Cambiar estos valores para cada nueva campaña:\n// ============================================\nconst CAMPANA_ID = 'invitatienda_enero_2026';\nconst TEMPLATE_NAME = 'invitatienda';\nconst IMAGEN_HEADER = 'https://oss-ycloud-publicread.oss-ap-southeast-1.aliyuncs.com/online/BASE-FILE/2025/12/28/2c9a5937-8289-4d56-80b9-b1dbb7acc2a7.jpg';\n// ============================================\n\nconst clientes = items.map(item => {\n  const cliente = item.json;\n  \n  // Limpiar teléfono\n  let telefono = cliente.telefono.replace(/\\D/g, '');\n  if (telefono.length === 10 && telefono.startsWith('3')) {\n    telefono = '57' + telefono;\n  } else if (!telefono.startsWith('57')) {\n    telefono = '57' + telefono;\n  }\n  \n  // ⭐ SOLO PRIMER NOMBRE (ejemplo: \"María González\" → \"María\")\n  const primerNombre = cliente.primer_nombre || 'Amigo';\n  \n  return {\n    json: {\n      cliente_id: cliente.id,\n      nombre_completo: cliente.nombre,\n      nombre: primerNombre,\n      telefono_original: cliente.telefono,\n      telefono_limpio: telefono,\n      campana_id: CAMPANA_ID,\n      mensaje_data: {\n        from: \"+573042582777\",\n        to: telefono,\n        type: \"template\",\n        template: {\n          name: TEMPLATE_NAME,\n          language: { code: \"es\" },\n          components: [\n            {\n              type: \"header\",\n              parameters: [{ type: \"image\", image: { link: IMAGEN_HEADER } }]\n            },\n            {\n              type: \"body\",\n              parameters: [{ type: \"text\", text: primerNombre }]\n            }\n          ]\n        }\n      }\n    }\n  };\n});\n\nreturn clientes;"
            },
            "id": "0c51c6fd-8cb9-4141-b952-4eeec955728a",
            "name": "🔧 Preparar Mensajes",
            "type": "n8n-nodes-base.code",
