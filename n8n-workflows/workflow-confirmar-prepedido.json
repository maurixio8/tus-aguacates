        {
            "parameters": {
                "jsCode": "// =====================================================\n// 🔍 VERIFICADOR DE PRECIOS v1.0\n// =====================================================\n// Compara precios del carrito vs. catálogo oficial\n// Si hay discrepancia, corrige al precio real\n// =====================================================\n\nconst cliente = $('📥 Obtener Pre-Pedido').first().json;\nconst items = cliente.pre_pedido || [];\nconst productosSupabase = $input.all().map(item => item.json);\n\n// Crear mapa de precios reales (ID -> Precio)\nconst preciosReales = {};\nproductosSupabase.forEach(p => {\n  preciosReales[p.id] = p.price;\n});\n\nlet totalVerificado = 0;\nlet hayDiscrepancias = false;\nconst itemsVerificados = [];\nconst discrepanciasDetectadas = [];\n\nitems.forEach(item => {\n  const productoId = item.producto_id || item.id;\n  const precioCarrito = parseFloat(item.precio) || 0;\n  const precioReal = preciosReales[productoId];\n  const cantidad = parseInt(item.cantidad) || 1;\n\n  let precioFinal = precioCarrito;\n  let estadoVerificacion = 'OK';\n\n  // VERIFICAR SI EL PRECIO ES CORRECTO\n  if (precioReal !== undefined && precioReal !== precioCarrito) {\n    hayDiscrepancias = true;\n    estadoVerificacion = 'CORREGIDO';\n    precioFinal = precioReal;\n    \n    discrepanciasDetectadas.push({\n      producto: item.producto_nombre || item.nombre,\n      precio_carrito: precioCarrito,\n      precio_real: precioReal,\n      diferencia: precioReal - precioCarrito\n    });\n  }\n\n  const subtotal = precioFinal * cantidad;\n  totalVerificado += subtotal;\n\n  itemsVerificados.push({\n    product_id: productoId,\n    product_name: item.producto_nombre || item.nombre || 'Producto',\n    quantity: cantidad,\n    unit_price: precioFinal,\n    variant_name: item.variante || null,\n    verificacion: estadoVerificacion\n  });\n});\n\n// Normalizar teléfono a formato con 57\nlet phone = (cliente.telefono || '').replace(/\\D/g, '');\nif (phone.length === 10 && phone.startsWith('3')) {\n  phone = '57' + phone;\n}\n\nreturn [{\n  json: {\n    guest_name: cliente.nombre || 'Cliente WhatsApp',\n    guest_phone: phone,\n    guest_email: null,\n    guest_address: cliente.direccion || 'Por confirmar',\n    order_data: {\n      items: itemsVerificados,\n      source: 'whatsapp',\n      pre_pedido_id: `WA-${Date.now()}`,\n      verificado: true,\n      discrepancias: hayDiscrepancias\n    },\n    total_amount: totalVerificado,\n    status: 'confirmado',\n    payment_status: 'pendiente',\n    telefono_original: cliente.telefono,\n    // Datos para notificación\n    verificacion_resultado: {\n      hay_discrepancias: hayDiscrepancias,\n      discrepancias: discrepanciasDetectadas,\n      total_verificado: totalVerificado\n    }\n  }\n}];"
            },
