                "jsonBody": "={{ \nconst datos = $('🔍 Verificar Precios').first().json;\nconst order = $('📤 Crear en Supabase').first().json;\nconst verificacion = datos.verificacion_resultado;\n\nlet mensaje = `🔔 *NUEVO PEDIDO CONFIRMADO*\\n\\n`;\nmensaje += `👤 Cliente: ${datos.guest_name}\\n`;\nmensaje += `📞 Teléfono: ${datos.guest_phone}\\n`;\nmensaje += `📍 Dirección: ${datos.guest_address}\\n`;\nmensaje += `💰 Total: $${verificacion.total_verificado.toLocaleString('es-CO')}\\n`;\nmensaje += `🆔 Order ID: ${order.id.substring(0, 8)}\\n\\n`;\n\nif (verificacion.hay_discrepancias) {\n  mensaje += `⚠️ *PRECIOS CORREGIDOS:*\\n`;\n  verificacion.discrepancias.forEach(d => {\n    mensaje += `• ${d.producto}: $${d.precio_carrito} → $${d.precio_real}\\n`;\n  });\n} else {\n  mensaje += `✅ Todos los precios verificados correctamente`;\n}\n\nJSON.stringify({\n  \"from\": \"573042582777\",\n  \"to\": \"573203062007\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": mensaje\n  }\n})\n}}",
                "options": {}
