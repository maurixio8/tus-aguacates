                "jsCode": "// Cliente encontrado - preparar contexto\nconst cliente = $('🔎 Buscar Cliente').first().json;\nconst mensaje = $('🔍 Extraer Datos Mensaje').first().json;\n\nreturn {\n  json: {\n    cliente_id: cliente.id,\n    telefono: mensaje.telefono,\n    nombre: cliente.nombre || mensaje.nombre,\n    email: cliente.email || '',\n    direccion: cliente.direccion || '',\n    total_pedidos: cliente.total_pedidos || 0,\n    es_nuevo: false,\n    mensaje_usuario: mensaje.mensaje,\n    tipo_mensaje: mensaje.tipo_mensaje\n  }\n};"
