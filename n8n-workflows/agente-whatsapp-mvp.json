            "parameters": {
                "jsCode": "// Extraer datos del mensaje de WhatsApp (YCloud/Meta format)\nconst body = $input.first().json.body || $input.first().json;\n\n// Estructura típica de YCloud\nconst message = body.whatsappInboundMessage || body;\n\n// Extraer información clave\nconst telefono = message.from || message.waId || '';\nconst nombre = message.customerProfile?.name || message.profile?.name || 'Cliente';\nconst tipoMensaje = message.type || 'text';\n\nlet textoMensaje = '';\nif (tipoMensaje === 'text') {\n  textoMensaje = message.text?.body || message.body || '';\n} else if (tipoMensaje === 'button') {\n  textoMensaje = message.button?.text || '';\n} else if (tipoMensaje === 'interactive') {\n  textoMensaje = message.interactive?.button_reply?.title || \n                 message.interactive?.list_reply?.title || '';\n}\n\n// Timestamp\nconst timestamp = message.timestamp || Date.now();\n\nreturn {\n  json: {\n    telefono: telefono.replace(/\\D/g, ''), // Solo números\n    nombre: nombre,\n    mensaje: textoMensaje,\n    tipo_mensaje: tipoMensaje,\n    timestamp: timestamp,\n    raw: body // Guardar original para debug\n  }\n};"
            },
            "id": "extraer-datos",
            "name": "🔍 Extraer Datos Mensaje",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
