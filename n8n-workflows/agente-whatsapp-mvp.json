        {
            "parameters": {
                "jsCode": "// Preparar mensaje para enviar via YCloud\nconst respuestaIA = $input.first().json.text || $input.first().json.output || '';\nconst contexto = $('🔀 Merge Contextos').first().json;\n\n// Limpiar respuesta\nlet mensaje = respuestaIA\n  .replace(/\\*\\*/g, '*') // Convertir bold markdown a WhatsApp\n  .trim();\n\n// Si la respuesta está vacía, mensaje de fallback\nif (!mensaje) {\n  mensaje = '¡Hola! 🥑 Gracias por escribirnos. En un momento te atenderemos. Mientras tanto, puedes ver nuestros productos en: https://tus-aguacates.vercel.app';\n}\n\nreturn {\n  json: {\n    to: contexto.telefono,\n    type: 'text',\n    text: {\n      body: mensaje\n    },\n    // Metadata para logging\n    _metadata: {\n      cliente_id: contexto.cliente_id,\n      nombre: contexto.nombre,\n      mensaje_original: contexto.mensaje_usuario,\n      timestamp: new Date().toISOString()\n    }\n  }\n};"
            },
