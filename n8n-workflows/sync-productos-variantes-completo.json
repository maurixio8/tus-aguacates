        {
            "parameters": {
                "jsCode": "// Transformar productos de Supabase\nconst productos = [];\n\nfor (const item of $input.all()) {\n  const p = item.json;\n  if (p.is_active === false) continue;\n  \n  productos.push({\n    json: {\n      supabase_id: p.id || null,\n      name: p.name || 'Sin nombre',\n      slug: p.slug || null,\n      description: p.description || null,\n      price: parseFloat(p.price) || 0,\n      discount_price: p.discount_price ? parseFloat(p.discount_price) : null,\n      category_name: p.category?.name || p.category_name || null,\n      category_id: p.category_id || null,\n      main_image_url: p.main_image_url || p.image_url || null,\n      stock: parseInt(p.stock) || 100,\n      is_active: p.is_active !== false,\n      is_featured: p.is_featured === true,\n      unit: p.unit || 'kg',\n      min_quantity: p.min_quantity || 1,\n      has_variants: p.has_variants || false,\n      synced_from_supabase_at: new Date().toISOString()\n    }\n  });\n}\n\nconsole.log(`Transformados ${productos.length} productos`);\nreturn productos;"
            },
            "id": "transform-productos",
            "name": "🔄 Transformar Productos",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                680,
                400
            ]
        },
        {
            "parameters": {
                "jsCode": "// Transformar variantes de Supabase\nconst variantes = [];\n\nfor (const item of $input.all()) {\n  const v = item.json;\n  if (v.is_active === false) continue;\n  \n  variantes.push({\n    json: {\n      supabase_id: v.id || null,\n      product_supabase_id: v.product_id || null,\n      variant_name: v.variant_name || 'Variante',\n      variant_value: v.variant_value || '',\n      price: parseFloat(v.price) || 0,\n      price_adjustment: parseFloat(v.price_adjustment) || 0,\n      stock_quantity: parseInt(v.stock_quantity) || 100,\n      sku: v.sku || null,\n      is_active: v.is_active !== false,\n      sort_order: parseInt(v.sort_order) || 0,\n      synced_from_supabase_at: new Date().toISOString()\n    }\n  });\n}\n\nconsole.log(`Transformadas ${variantes.length} variantes`);\nreturn variantes;"
            },
            "id": "transform-variantes",
            "name": "🔄 Transformar Variantes",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                680,
