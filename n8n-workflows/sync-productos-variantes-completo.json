                "operation": "executeQuery",
                "query": "SELECT \n  (SELECT COUNT(*) FROM productos_tienda) as total_productos,\n  (SELECT COUNT(*) FROM variantes_productos) as total_variantes,\n  (SELECT COUNT(DISTINCT product_supabase_id) FROM variantes_productos) as productos_con_variantes,\n  NOW() as sync_timestamp;",
