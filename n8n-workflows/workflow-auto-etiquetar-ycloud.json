                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "🚫 Sin clientes pendientes",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "🏷️ Etiquetar en YCloud": {
            "main": [
                [
                    {
                        "node": "✅ Marcar como etiquetado",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "active": false,
    "settings": {
        "executionOrder": "v1"
    },
