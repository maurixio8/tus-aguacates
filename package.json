{
  "name": "tus-aguacates",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib tests scripts --ext .js,.mjs,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run test:critical",
    "validate:ci": "npm run typecheck && npm run test:critical && npm run build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:critical": "vitest run tests/unit/cart-store-baseline.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:install": "playwright install",
    "test:e2e:admin": "playwright test tests/e2e/admin",
    "test:e2e:admin:auth": "playwright test tests/e2e/admin/auth",
    "test:e2e:admin:products": "playwright test tests/e2e/admin/products",
    "test:e2e:admin:customers": "playwright test tests/e2e/admin/customers",
    "test:e2e:admin:dashboard": "playwright test tests/e2e/admin/dashboard",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm run test:run && npm run test:e2e",
    "whatsapp:validate": "node scripts/validate-whatsapp-config.js",
    "whatsapp:test": "node scripts/test-whatsapp-direct.js",
    "whatsapp:deploy": "cross-env-shell-supabase supabase functions deploy dual-whatsapp-notification",
    "deploy:functions": "cross-env-shell-supabase supabase functions deploy --no-verify-jwt",
    "deploy:all": "npm run build && npm run deploy:functions",
    "test:wishlist": "node scripts/test-wishlist-api.mjs",
    "analyze:bundle": "ANALYZE=true npm run build",
    "analyze:deps": "node scripts/analyze-bundle.js",
    "update:image-cache": "node scripts/update-image-cache.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@react-google-maps/api": "^2.20.7",
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/auth-helpers-react": "^0.15.0",
    "@supabase/supabase-js": "^2.80.0",
    "@tanstack/react-query": "^5.90.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.552.0",
    "next": "^16.0.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "xss": "^1.0.15",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.0.10",
    "@playwright/test": "^1.40.1",
    "@swc/core": "^1.15.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/google.maps": "^3.58.1",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^1.0.4",
    "@vitest/ui": "^1.0.4",
    "autoprefixer": "^10.4.22",
    "bcryptjs": "^3.0.3",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "^15.5.6",
    "jsdom": "^23.0.1",
    "jsonwebtoken": "^9.0.2",
    "msw": "^2.0.11",
    "pg": "^8.18.0",
    "postcss": "^8.5.6",
    "puppeteer": "^24.32.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^1.0.4",
    "web-vitals": "^5.1.0"
  }
}
